# Puerto del servidor
PORT=3000

# Clave secreta para firmar JWT (¡cámbiala en producción!)
JWT_SECRET=cambia-esta-clave-secreta-por-una-larga

# Driver de base de datos: sqlite | postgres
# Con sqlite solo necesitas DATABASE_URL apuntando a un archivo.
# Para migrar a PostgreSQL/Supabase solo cambia DB_DRIVER y DATABASE_URL.
DB_DRIVER=sqlite
DATABASE_URL=./data/mapa-sticker.db

# Ejemplo de migración futura a la nube:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://usuario:password@host.supabase.co:5432/postgres

# --- Storage de imágenes (Supabase Storage) ---
# En producción activa SUPABASE_STORAGE=true con las credenciales de tu proyecto.
# Sin estas variables las imágenes se guardan en public/uploads/ (solo para desarrollo:
# en Render ese disco es efímero y las imágenes se pierden en cada redeploy).
#
# Crea un bucket público llamado "mapa-sticker" y en SQL Editor añade:
#   create policy "public read" on storage.objects for select using (bucket_id = 'mapa-sticker');
#   create policy "service insert" on storage.objects for insert with check (bucket_id = 'mapa-sticker');
#   create policy "service update" on storage.objects for update using (bucket_id = 'mapa-sticker');
#   create policy "service delete" on storage.objects for delete using (bucket_id = 'mapa-sticker');
#
# SUPABASE_STORAGE=true
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# SUPABASE_STORAGE_BUCKET=mapa-sticker
